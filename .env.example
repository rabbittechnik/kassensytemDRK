# ── Vite blendet VITE_* beim BUILD ein (import.meta.env). ───────────────────────────
#
# Railway / gleiche öffentliche URL für UI + API (empfohlen):
#   Frontend: VITE_API_BASE_URL=/api  (oder weglassen → Default ist /api)
#   Backend:  API_MOUNT_PATH=/api      (siehe drk-kasse-api/.env.example)
#   Dann z. B. GET https://<host>/api/teams , POST https://<host>/api/sales
#
VITE_API_BASE_URL=/api
#
# ── Lokale Entwicklung: API direkt ohne /api-Präfix (Port 8787) ───────────────────
# VITE_API_BASE_URL=http://127.0.0.1:8787
#
# ── Lokale Entwicklung: API mit Präfix /api (Vite-Proxy in vite.config leitet weiter) ─
# Backend: API_MOUNT_PATH=/api
# VITE_API_BASE_URL=/api
#
# ── separates Backend nur mit öffentlicher URL ────────────────────────────────────
# VITE_API_BASE_URL=https://dein-backend-xxxx.up.railway.app
