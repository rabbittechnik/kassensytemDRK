# ── Wichtig: Vite blendet diese Werte beim BUILD ein („import.meta.env“). ─────────
# Auf Railway beim FRONTEND-Dienst optional; wenn die Variable fehlt oder leer ist,
# verwendet die App automatisch die relative Basis „/api“ (gleiche Origin).
#
# ── Standard (empfohlen auf Railway mit einem Host + API_MOUNT_PATH=/api) ─────────
# Nichts setzen ODER explizit:
# VITE_API_BASE_URL=/api
#
# ── Lokale Entwicklung: API direkt ohne /api-Präfix (Port 8787) ───────────────────
VITE_API_BASE_URL=http://127.0.0.1:8787
#
# ── Lokale Entwicklung: API mit Präfix /api (Vite-Proxy leitet /api → Ziel weiter) ─
# Backend: API_MOUNT_PATH=/api
# VITE_API_BASE_URL=/api
#
# ── separates Backend nur mit öffentlicher URL ────────────────────────────────────
# VITE_API_BASE_URL=https://dein-backend-xxxx.up.railway.app
