# Daten & Server — auf Railway Volume z. B. DATA_ROOT=/DATA
DATA_ROOT=./.data
PORT=8787
# SQLite-Datei: {DATA_ROOT}/db/kasse.sqlite (persistent, wenn DATA_ROOT auf Volume zeigt)

# Routen ohne Präfix (lokal oder direktes Backend ohne Reverse-Proxy unter /api):
# API_MOUNT_PATH leer lassen (oder nicht setzen)

# Wenn Frontend und API dieselbe Öffentliche URL nutzen und die API unter /api liegt:
API_MOUNT_PATH=/api

JWT_SECRET=change-me-in-production
CORS_ORIGIN=*
